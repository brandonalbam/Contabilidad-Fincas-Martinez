{
  "name": "Frutas La Estrella — Contabilidad",
  "short_name": "La Estrella",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0c1611",
  "theme_color": "#0c1611",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "./compartir-chat",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "chat",
          "accept": [
            "text/plain",
            ".txt",
            "application/zip",
            ".zip",
            "application/x-zip-compressed",
            "image/*",
            "*/*"
          ]
        }
      ]
    }
  }
}